# Robinhood Webhook Handler Configuration
# Copy to .env and fill in real values

# ============================================================================
# WEBHOOK SIGNATURE VALIDATION (REQUIRED)
# ============================================================================

# Shared secret for HMAC-SHA256 signature validation
# Generate: openssl rand -base64 32
# Provided by Robinhood API support
ROBINHOOD_WEBHOOK_SECRET="your-robinhood-webhook-secret-here"

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Path to clients.db (SQLite)
# Default: clients.db (in current directory)
# Production: use absolute path
CLIENTS_DB_PATH="/path/to/clients.db"

# Database connection timeout (seconds)
# Default: 5.0
DB_TIMEOUT="5.0"

# ============================================================================
# ALERT THRESHOLDS
# ============================================================================

# Daily loss limit (circuit breaker) — stops trading if exceeded
# Default: $100.00
DAILY_LOSS_THRESHOLD="100.00"

# Daily gain target — alerts when reached
# Default: $500.00
DAILY_GAIN_THRESHOLD="500.00"

# Minimum acceptable win rate percentage
# Default: 45.0%
WIN_RATE_THRESHOLD="45.0"

# Margin utilization warning threshold (percentage)
# Default: 25%
MARGIN_CALL_THRESHOLD="25.0"

# ============================================================================
# DASHBOARD & REAL-TIME UPDATES
# ============================================================================

# WebSocket URL for mobile dashboard updates (optional)
# Used to push real-time trade/alert updates
# Example: wss://yourdomain.com/ws/dashboard
DASHBOARD_WS_URL="wss://yourdomain.com/ws/dashboard"

# ============================================================================
# ALERT NOTIFICATION CHANNELS (OPTIONAL)
# ============================================================================

# Telegram Bot Token (for critical alerts)
# Get from @BotFather on Telegram
# Optional — only needed for Telegram notifications
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Telegram Chat ID (where alerts are sent)
# Find: https://api.telegram.org/botYOUR_TOKEN/getUpdates
TELEGRAM_CHAT_ID="your-chat-id"

# Email settings for alert notifications
# SMTP host for sending alerts
ALERT_EMAIL_HOST="smtp.gmail.com"
ALERT_EMAIL_PORT="587"
ALERT_EMAIL_USERNAME="your-email@gmail.com"
ALERT_EMAIL_PASSWORD="your-app-password"
ALERT_EMAIL_FROM="alerts@yourdomain.com"
ALERT_EMAIL_TO="recipient@example.com"

# ============================================================================
# ROBINHOOD API CONNECTION
# ============================================================================

# Robinhood OAuth token (if using MCP client)
# Generated from Robinhood OAuth flow
ROBINHOOD_OAUTH_TOKEN="your-robinhood-oauth-token"

# Robinhood API Base URL
# Production: https://agent.robinhood.com/mcp/trading
# Default: https://api.robinhood.com
ROBINHOOD_API_URL="https://agent.robinhood.com/mcp/trading"

# Robinhood account ID to monitor
# Example: 12345-6789
ROBINHOOD_ACCOUNT_ID="your-account-id"

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL="INFO"

# Log file path (optional)
# If not set, logs to stdout
# Example: /var/log/profitengine/webhook.log
LOG_FILE="/path/to/webhook.log"

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================

# Host to bind webhook handler
# Development: 127.0.0.1
# Production: 0.0.0.0 (listen on all interfaces)
WEBHOOK_HOST="0.0.0.0"

# Port for webhook handler
# Default: 8001
WEBHOOK_PORT="8001"

# Public webhook URL (for Robinhood callback registration)
# Example: https://yourdomain.com/api/webhooks/webhook/robinhood
WEBHOOK_PUBLIC_URL="https://yourdomain.com/api/webhooks/webhook/robinhood"

# ============================================================================
# IDEMPOTENCY & RETRY
# ============================================================================

# Maximum webhook processing retries
# Default: 3
WEBHOOK_MAX_RETRIES="3"

# Initial retry delay in seconds
# Default: 1.0
WEBHOOK_RETRY_DELAY="1.0"

# Webhook event timeout (max age to process)
# Default: 300 seconds (5 minutes)
WEBHOOK_MAX_AGE_SEC="300"

# ============================================================================
# PERFORMANCE & MONITORING
# ============================================================================

# Enable detailed performance logging
# Default: false
ENABLE_PERF_LOGGING="false"

# Metrics collection endpoint (optional)
# Example: https://metrics.yourdomain.com/push
METRICS_ENDPOINT="https://metrics.yourdomain.com/push"

# Health check interval (seconds)
# Default: 60
HEALTH_CHECK_INTERVAL="60"

# ============================================================================
# SECURITY
# ============================================================================

# Enable signature validation
# Default: true (always enable in production)
ENABLE_SIGNATURE_VALIDATION="true"

# Enable timestamp verification (replay attack prevention)
# Default: true (always enable in production)
ENABLE_TIMESTAMP_VERIFICATION="true"

# IP whitelist for webhooks (optional)
# Comma-separated list of allowed IPs
# Example: 1.2.3.4,5.6.7.8
WEBHOOK_IP_WHITELIST=""

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable real-time WebSocket updates to dashboard
# Default: true
ENABLE_WEBSOCKET_UPDATES="true"

# Enable Telegram alert notifications
# Default: false
ENABLE_TELEGRAM_ALERTS="false"

# Enable email alert notifications
# Default: false
ENABLE_EMAIL_ALERTS="false"

# Enable circuit breaker (pause trading on daily loss)
# Default: true
ENABLE_CIRCUIT_BREAKER="true"

# Enable profit locking (alert on daily gains)
# Default: true
ENABLE_PROFIT_LOCKING="true"

# ============================================================================
# DEVELOPMENT / TESTING
# ============================================================================

# Skip signature validation (DEV ONLY - never in production)
# Default: false
SKIP_SIGNATURE_VALIDATION="false"

# Test mode (use mock data instead of real database)
# Default: false
TEST_MODE="false"

# Mock event data file (for testing)
# JSON file with test events
MOCK_EVENTS_FILE="test_events.json"
