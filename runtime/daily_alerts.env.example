# ProfitEngine Daily Alerts Configuration
# Copy to .env and fill in actual values
# NEVER commit .env to git

# ============================================================================
# EMAIL PROVIDER
# ============================================================================

# Options: gmail, sendgrid, aws_ses
EMAIL_PROVIDER=gmail

# Alert recipient email (dispatch@alreadyherellc.com for production)
ALERT_EMAIL=dispatch@alreadyherellc.com

# ============================================================================
# GMAIL CONFIGURATION (if EMAIL_PROVIDER=gmail)
# ============================================================================

# Your Gmail address (can be different from sender)
GMAIL_USER=your-email@gmail.com

# 16-character app password from https://myaccount.google.com/apppasswords
# Note: Must have 2-factor auth enabled
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ============================================================================
# SENDGRID CONFIGURATION (if EMAIL_PROVIDER=sendgrid)
# ============================================================================

# SendGrid API key (starts with SG.)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# AWS SES CONFIGURATION (if EMAIL_PROVIDER=aws_ses)
# ============================================================================

# AWS access key ID
AWS_ACCESS_KEY_ID=AKIA6XXXXXXXXXXXX

# AWS secret access key
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS region (e.g., us-east-1, us-west-2)
AWS_SES_REGION=us-east-1

# ============================================================================
# DATABASE
# ============================================================================

# Path to clients.db
# Examples:
#   /home/opc/profitengine/runtime/clients.db (OCI Linux)
#   C:\path\to\profitengine\runtime\clients.db (Windows)
#   clients.db (current directory)
CLIENTS_DB_PATH=clients.db

# ============================================================================
# TELEGRAM ALERTS (OPTIONAL)
# ============================================================================

# Telegram bot token from @BotFather
# Leave empty to disable Telegram alerts
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Chat ID where alerts will be sent
# Get via: curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# ============================================================================
# SLACK ALERTS (OPTIONAL)
# ============================================================================

# Slack incoming webhook URL
# Create at: https://api.slack.com/messaging/webhooks
# Leave empty to disable Slack alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# ============================================================================
# LOGGING
# ============================================================================

# Log file location (relative to runtime directory)
DAILY_ALERTS_LOG_FILE=daily_alerts.log

# Log level: DEBUG, INFO, WARNING, ERROR
DAILY_ALERTS_LOG_LEVEL=INFO
