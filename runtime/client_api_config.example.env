# ============================================================================
# CLIENT API CONFIGURATION
# Copy to .env and update with real values for production
# ============================================================================

# ── API AUTHENTICATION ───────────────────────────────────────────────────
# Generate API key hash:
#   python -c "import hashlib; print(hashlib.sha256(b'your-secure-key').hexdigest())"
# Store the hash, distribute the plaintext key to client repos

# Hash of the API key (64 chars, SHA-256 hex)
# For production: use a long random string (32+ chars) hashed with SHA-256
CLIENT_API_KEY_HASH=9b7a8c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f

# Webhook secret for signature verification (HMAC-SHA256)
# Used to verify requests from GitHub Actions or automated systems
CLIENT_API_WEBHOOK_SECRET=your-secure-webhook-secret-change-in-production


# ── DATABASE ─────────────────────────────────────────────────────────────
# Path to SQLite database file containing client trading data
CLIENTS_DB_PATH=/data/clients.db

# Backup path (optional, for health checks)
CLIENTS_DB_BACKUP_PATH=/data/clients.backup.db


# ── SERVER CONFIGURATION ────────────────────────────────────────────────
# Host and port for FastAPI server
CLIENT_API_HOST=0.0.0.0
CLIENT_API_PORT=8001

# Environment (development, staging, production)
ENVIRONMENT=production

# Enable debug logging (false for production)
DEBUG=false

# CORS origins (comma-separated, '*' for all)
CLIENT_API_CORS_ORIGINS=https://profitengine-tau.vercel.app,https://quantam101.github.io


# ── RATE LIMITING ──────────────────────────────────────────────────────
# Number of requests allowed per window
CLIENT_API_RATE_LIMIT_REQUESTS=100

# Time window in seconds (3600 = 1 hour)
CLIENT_API_RATE_LIMIT_WINDOW=3600


# ── MONITORING & LOGGING ───────────────────────────────────────────────
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log file path (optional)
LOG_FILE=/var/log/profitengine/client_api.log

# Enable structured logging (JSON)
JSON_LOGS=true

# Sentry error tracking (optional)
SENTRY_DSN=


# ── PERFORMANCE ────────────────────────────────────────────────────────
# Connection pool size for database
DB_POOL_SIZE=10

# Query timeout in seconds
DB_QUERY_TIMEOUT=30

# Cache TTL for stats (seconds)
CACHE_TTL=300

# Enable query caching
ENABLE_QUERY_CACHE=true


# ── INTEGRATION ────────────────────────────────────────────────────────
# For profitengine-tau (frontend)
PROFITENGINE_CLIENT_API_URL=https://runtime.alreadyhere.com/api
PROFITENGINE_CLIENT_API_KEY=your-api-key-here

# For content repo
CONTENT_REPO_API_KEY=your-api-key-here

# For sales engine
SALES_API_KEY=your-api-key-here


# ── SCHEDULED TASKS ────────────────────────────────────────────────────
# Cron schedule for cache refresh (optional)
CACHE_REFRESH_SCHEDULE=*/5 * * * *

# Cron schedule for stats materialization
STATS_MATERIALIZATION_SCHEDULE=*/10 * * * *

# Cron schedule for health checks
HEALTH_CHECK_SCHEDULE=*/2 * * * *


# ── ALERTS & NOTIFICATIONS ─────────────────────────────────────────────
# Slack webhook for alerts
SLACK_WEBHOOK_URL=

# Email for critical alerts
ALERT_EMAIL=ops@alreadyhere.com

# Threshold for slow queries (ms)
SLOW_QUERY_THRESHOLD=1000

# Threshold for API errors (%, per 5 min)
ERROR_RATE_THRESHOLD=5


# ── SECURITY ──────────────────────────────────────────────────────────
# IP whitelist (comma-separated, empty = allow all)
IP_WHITELIST=

# Require HTTPS (production only)
REQUIRE_HTTPS=true

# HSTS max age (seconds)
HSTS_MAX_AGE=31536000

# API key rotation period (days)
API_KEY_ROTATION_PERIOD=90
