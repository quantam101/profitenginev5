# ProfitEngine v5 Sync Engine — Environment Configuration
#
# Copy this file to .env or .env.local and fill in your values.
# Never commit actual tokens to the repository.
#
# Set these variables in:
#   1. Server .env file
#   2. GitHub Secrets (for GitHub Actions)
#   3. systemd EnvironmentFile
#   4. Docker environment variables

# ──────────────────────────────────────────────────────────────────────────────
# GITHUB REPOSITORY CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────

# The GitHub repository URL to clone and sync to
# Default: https://github.com/quantam101/profitenginev5.git
PROFITENGINEV5_REPO_URL=https://github.com/quantam101/profitenginev5.git

# Local path where the repository will be cloned
# Default: /tmp/profitenginev5
# Note: Must be writable by the sync service user
PROFITENGINEV5_LOCAL_PATH=/tmp/profitenginev5

# Git branch to commit to (typically 'main')
# Default: main
PROFITENGINEV5_BRANCH=main

# ──────────────────────────────────────────────────────────────────────────────
# GITHUB AUTHENTICATION
# ──────────────────────────────────────────────────────────────────────────────

# GitHub Personal Access Token (PAT) with 'repo' scope
# REQUIRED for authentication
# Get it from: https://github.com/settings/tokens
# Scope needed: repo (full control of repositories)
# Expiration: Set to 90 days and rotate regularly
#
# SECURITY WARNING:
#   - NEVER commit this value to your repository
#   - Always store in environment variables or secrets management
#   - Regenerate every 90 days
#   - Delete old tokens immediately after rotation
#
GITHUB_PROFITENGINEV5_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub username/email for commit attribution
# This appears in the git log for all synced commits
# Default: profitengine-sync
GITHUB_PROFITENGINEV5_USER=profitengine-sync

# Email address for commit attribution
# Default: sync@profitengine.local
GITHUB_PROFITENGINEV5_EMAIL=sync@profitengine.local

# ──────────────────────────────────────────────────────────────────────────────
# LOGGING CONFIGURATION (Optional)
# ──────────────────────────────────────────────────────────────────────────────

# Path to log file for sync operations
# If not set, logs only go to stdout/stderr
# Default: /var/log/profitenginev5-sync.log
PROFITENGINEV5_SYNC_LOG_FILE=/var/log/profitenginev5-sync.log

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
PROFITENGINEV5_SYNC_LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────────────────
# ADVANCED CONFIGURATION (Optional)
# ──────────────────────────────────────────────────────────────────────────────

# Git timeout (seconds)
# How long to wait for git operations before timing out
# Default: 30
PROFITENGINEV5_GIT_TIMEOUT=30

# Maximum commit message length (characters)
# Default: 200
PROFITENGINEV5_COMMIT_MESSAGE_MAX_LENGTH=200

# Enable experimental features
# Default: false
PROFITENGINEV5_ENABLE_EXPERIMENTAL=false

# ──────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT-SPECIFIC SETTINGS
# ──────────────────────────────────────────────────────────────────────────────

# For systemd service
# User to run the service as (must exist on system)
PROFITENGINEV5_SERVICE_USER=profitengine

# For Docker deployments
# Docker container working directory
PROFITENGINEV5_CONTAINER_WORKDIR=/app

# For GitHub Actions
# Whether to auto-create branches if they don't exist
PROFITENGINEV5_AUTO_CREATE_BRANCH=false

# ──────────────────────────────────────────────────────────────────────────────
# EXAMPLE CONFIGURATIONS
# ──────────────────────────────────────────────────────────────────────────────

# LOCAL DEVELOPMENT (single machine, git cloning to /tmp)
# PROFITENGINEV5_REPO_URL=https://github.com/quantam101/profitenginev5.git
# PROFITENGINEV5_LOCAL_PATH=/tmp/profitenginev5
# GITHUB_PROFITENGINEV5_TOKEN=ghp_xxxx
# GITHUB_PROFITENGINEV5_USER=your-github-username
# GITHUB_PROFITENGINEV5_EMAIL=your-email@example.com

# PRODUCTION SERVER (OCI instance, persistent location)
# PROFITENGINEV5_REPO_URL=https://github.com/quantam101/profitenginev5.git
# PROFITENGINEV5_LOCAL_PATH=/opt/profitengine/repos/profitenginev5
# PROFITENGINEV5_BRANCH=main
# GITHUB_PROFITENGINEV5_TOKEN=ghp_xxxx
# GITHUB_PROFITENGINEV5_USER=profitengine-sync-bot
# GITHUB_PROFITENGINEV5_EMAIL=bot@profitengine.local
# PROFITENGINEV5_SYNC_LOG_FILE=/var/log/profitenginev5-sync.log
# PROFITENGINEV5_SERVICE_USER=profitengine

# GITHUB ACTIONS (cloud-based, uses Secrets)
# PROFITENGINEV5_REPO_URL=https://github.com/quantam101/profitenginev5.git
# PROFITENGINEV5_LOCAL_PATH=/tmp/profitenginev5
# GITHUB_PROFITENGINEV5_TOKEN=${{ secrets.GITHUB_PROFITENGINEV5_TOKEN }}
# GITHUB_PROFITENGINEV5_USER=github-actions[bot]
# GITHUB_PROFITENGINEV5_EMAIL=41898282+github-actions[bot]@users.noreply.github.com

# DOCKER (container-based, uses environment)
# PROFITENGINEV5_REPO_URL=https://github.com/quantam101/profitenginev5.git
# PROFITENGINEV5_LOCAL_PATH=/tmp/profitenginev5
# PROFITENGINEV5_CONTAINER_WORKDIR=/app
# GITHUB_PROFITENGINEV5_TOKEN=ghp_xxxx
# GITHUB_PROFITENGINEV5_USER=docker-profitengine
# GITHUB_PROFITENGINEV5_EMAIL=docker@profitengine.local

# ──────────────────────────────────────────────────────────────────────────────
# TROUBLESHOOTING
# ──────────────────────────────────────────────────────────────────────────────

# If you see authentication errors:
# 1. Verify GITHUB_PROFITENGINEV5_TOKEN is set and valid
# 2. Check token hasn't expired (regenerate if needed)
# 3. Verify token has 'repo' scope
# 4. Test: curl -H "Authorization: token XXXX" https://api.github.com/user

# If you see path errors:
# 1. Verify PROFITENGINEV5_LOCAL_PATH is writable
# 2. Check parent directory exists: mkdir -p $(dirname $PROFITENGINEV5_LOCAL_PATH)
# 3. Check permissions: chmod 755 /path/to/directory

# If you see git errors:
# 1. Verify git is installed: which git
# 2. Check git config: git config --list
# 3. Test clone manually: git clone $PROFITENGINEV5_REPO_URL /tmp/test-sync

# For detailed logging, set PROFITENGINEV5_SYNC_LOG_LEVEL=DEBUG
