# Already Here LLC — Hypervisor Environment Variables
# Copy to .env and fill in values before running docker-compose up

# Required — gateway auth token (generate with: openssl rand -hex 32)
LITELLM_MASTER_KEY=

# LLM providers (at least one required)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional — local Ollama override (defaults to Docker bridge 172.17.0.1)
# LOCAL_OLLAMA_URL=http://172.17.0.1:11434/api/generate

# ProfitEngine backend — set GATEWAY_URL to enable hypervisor routing
# GATEWAY_URL=http://localhost:4000

# AGENT_MESH_OS Redis broker (from runtime/agent-mesh-os)
# REDIS_URL=redis://:yourpassword@localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PASSWORD=yourpassword

# AGENT_MESH_OS SQLite state DB path
# MESH_STATE_DB=/home/opc/agent_mesh_os/data/state/agent_mesh_state.db
