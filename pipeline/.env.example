# Already Here LLC — Pipeline Config
# IMPORTANT: Copy to .env and fill with YOUR values
# NEVER commit .env — it contains secrets
# Use GitHub Secrets instead for production

# ── Email (Gmail App Password) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_REPLY_TO=your-reply-email@gmail.com

# ── Outreach Identity ──────────────────────────────────────────────────
OUTREACH_SENDER_NAME=Your Name
OUTREACH_SENDER_TITLE=Your Title
OUTREACH_COMPANY=Already Here LLC

# ── Database ───────────────────────────────────────────────────────────
MESH_DB_PATH=production_mesh_edge.db

# ── Slack Channels ────────────────────────────────────────────────────
SLACK_REVENUE_CHANNEL=your-channel-id-here

# ── Stripe (for payments) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ── ConvertKit (for email) ────────────────────────────────────────────
CONVERTKIT_API_KEY=your-convertkit-api-key-here
CONVERTKIT_API_SECRET=your-convertkit-api-secret-here

# ── Database Connection ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:port/database
POSTGRES_CONNECTION_STRING=postgresql://user:password@host:port/database

# ── OCI Server (for deployments) ───────────────────────────────────────
OCI_SSH_KEY=your-ssh-private-key-here
OCI_HOST=129.146.167.73
OCI_USER=opc

# ── GitHub (for CI/CD) ────────────────────────────────────────────────
GITHUB_TOKEN=your-github-token-here

# HOW TO GET THESE VALUES:
#
# SMTP_PASSWORD:
#   1. Go to myaccount.google.com
#   2. Security → App passwords
#   3. Generate new app password for "Mail"
#
# SLACK_REVENUE_CHANNEL:
#   1. Go to Slack workspace
#   2. Right-click channel → Copy channel ID
#
# STRIPE_SECRET_KEY:
#   1. Go to stripe.com → Dashboard
#   2. Developers → API keys
#   3. Copy "Secret key"
#
# CONVERTKIT_API_KEY:
#   1. Go to app.convertkit.com → Settings → API
#   2. Copy API key
#
# DATABASE_URL:
#   1. Go to Neon.tech → Project → Connection string
#   2. Copy the pooled connection URL
