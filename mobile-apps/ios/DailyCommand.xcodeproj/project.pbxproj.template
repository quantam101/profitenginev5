// Xcode Project Configuration Template
// Run: xcodebuild -project DailyCommand.xcodeproj -scheme DailyCommand -configuration Debug

DEVELOPMENT_TEAM = ""  // set via XCODE_DEVELOPMENT_TEAM env var or manually in project.pbxproj
PRODUCT_BUNDLE_IDENTIFIER = com.dailycommand.ios
SWIFT_VERSION = 5.9
IPHONEOS_DEPLOYMENT_TARGET = 14.0
MACOSX_DEPLOYMENT_TARGET = 11.0

// Build Settings
CODE_SIGN_IDENTITY = iPhone Developer
PROVISIONING_PROFILE_SPECIFIER = DailyCommand Development
DEBUG_INFORMATION_FORMAT = dwarf
ENABLE_TESTABILITY = YES

// Signing (update with your Apple Developer account)
DEVELOPMENT_TEAM[sdk=iphoneos*] = YOUR_TEAM_ID
CODE_SIGN_STYLE = Automatic
PROVISIONING_PROFILE_SPECIFIER[sdk=iphoneos*] = match Development com.dailycommand.ios

// Capabilities Required
// - Push Notifications
// - Maps
// - Location Services
// - Camera
// - Photos

// Info.plist Additions
NSLocationWhenInUseUsageDescription = "Daily Command needs your location to navigate to jobs"
NSCameraUsageDescription = "Daily Command needs camera access to capture job photos"
NSPhotoLibraryUsageDescription = "Daily Command needs photo library access"
UIMainStoryboardFile =
UILaunchStoryboardName = LaunchScreen
