{
  "name": "profitenginev5",
  "version": "0.1.6-supervised-autopublish-gate",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "content:factory": "python scripts/content_factory_run.py --campaign campaigns/referrals/acorns-2026-06-09.json --output generated-content",
    "autopublish:gate": "python scripts/autopublish_gate.py --campaign campaigns/referrals/acorns-2026-06-09.json --channel owned_website_news --as-of 2026-06-09",
    "autopublish:gate:launch": "python scripts/autopublish_gate.py --campaign campaigns/referrals/acorns-2026-06-09.json --channel owned_website_news --as-of 2026-06-23 --strict",
    "test": "npm run test:unit && npm run test:regression && npm run test:integration && npm run test:ai-gateway && npm run test:skill-gateway",
    "test:regression": "python -m pytest tests/ -q",
    "test:unit": "python -m pytest code_merger/tests/ -q",
    "test:integration": "node tests/health-contract.test.mjs",
    "test:ai-gateway": "node tests/ai-gateway.test.mjs",
    "test:skill-gateway": "node tests/skill-gateway.test.mjs",
    "test:export": "node tests/export-system.test.mjs",
    "test:opportunity": "python -m pytest tests/test_opportunity_intelligence.py -q",
    "test:content-factory": "python -m pytest tests/test_content_factory.py -q",
    "test:autopublish-gate": "python -m pytest tests/test_autopublish_gate.py -q",
    "test:runtime": "python -m pytest -q",
    "test:full": "python -m pytest tests/test_full_suite.py -v && node tests/full-suite.test.mjs --skip-live",
    "test:full:live": "python -m pytest tests/test_full_suite.py -v && node tests/full-suite.test.mjs",
    "test:smoke": "python -m pytest tests/test_full_suite.py -v -k smoke",
    "test:latency": "python -m pytest tests/test_full_suite.py -v -k latency",
    "test:load": "python -m pytest tests/test_full_suite.py -v -k load",
    "test:timeout": "python -m pytest tests/test_full_suite.py -v -k timeout",
    "eval:ai-gateway": "node scripts/eval-ai-gateway.mjs",
    "eval:skill-gateway": "node scripts/eval-skill-gateway.mjs",
    "validate:yaml": "python scripts/validate_yaml.py",
    "security:scan": "python scripts/security_check.py",
    "security:audit": "npm audit --audit-level=critical --omit=dev",
    "agents:parallel": "node scripts/run-parallel-agents.mjs",
    "agents:opportunity": "python scripts/opportunity_intelligence_run.py",
    "edge:replay": "python scripts/edge_failover_replay.py",
    "ci:all": "npm run lint && npm run typecheck && npm run validate:yaml && npm run test:unit && npm run test:integration && npm run test:ai-gateway && npm run test:skill-gateway && npm run test:opportunity && npm run test:content-factory && npm run test:autopublish-gate && npm run eval:ai-gateway && npm run eval:skill-gateway && npm run security:scan && npm run build",
    "ci:security": "npm run security:audit && npm run security:scan",
    "ci:full": "npm run ci:all && npm run ci:security && npm run test:full",
    "healthcheck": "node scripts/agent-healthcheck.mjs",
    "db:init": "npx ts-node scripts/init-db.ts",
    "db:init:seed": "npx ts-node scripts/init-db.ts --seed",
    "db:test": "node -e \"require('pg').Pool({connectionString: process.env.DATABASE_URL || 'postgres://profitengine:password@localhost:5432/profitengine'}).query('SELECT NOW()', (e,r) => { console.log(e ? '❌ Connection failed: ' + e.message : '✅ Connected'); process.exit(e ? 1 : 0) })\""
  },
  "dependencies": {
    "mongodb": "^7.2.0",
    "next": "15.5.18",
    "next-auth": "^4.24.14",
    "pg": "^8.21.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@types/node": "22.10.10",
    "@types/pg": "^8.20.0",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.18",
    "postcss": "8.5.10",
    "typescript": "5.7.3"
  },
  "overrides": {
    "postcss": "8.5.10",
    "uuid": "^11.1.1"
  }
}
