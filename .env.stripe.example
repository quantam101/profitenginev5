# STRIPE PAYMENT AUTOMATION CONFIGURATION
# Copy this file to .env.local and fill in with your production values

# ============================================================================
# STRIPE API CREDENTIALS
# ============================================================================

# Your Stripe Secret Key (never share or expose in frontend)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_YOUR_SECRET_KEY_HERE

# Webhook Signing Secret for validating webhook events
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Stripe Publishable Key (safe to expose in frontend)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_PUBLIC_KEY_HERE

# ============================================================================
# PRODUCT & PRICE IDs
# ============================================================================

# Stripe Product IDs (comma-separated if multiple)
# Get from: https://dashboard.stripe.com/products
STRIPE_PRODUCT_IDS=prod_your_product_id

# Monthly subscription prices
STRIPE_PRICE_STARTER=price_monthly_starter
STRIPE_PRICE_PROFESSIONAL=price_monthly_pro
STRIPE_PRICE_ENTERPRISE=price_monthly_enterprise

# Annual subscription prices
STRIPE_PRICE_STARTER_ANNUAL=price_annual_starter
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_annual_pro
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_annual_enterprise

# ============================================================================
# WEBHOOK CONFIGURATION
# ============================================================================

# Webhook endpoint (your application URL + path)
WEBHOOK_URL=https://yourdomain.com/api/automation/stripe/webhook

# Enable timestamp verification for webhook security
WEBHOOK_VERIFY_TIMESTAMP=true

# Tolerance for webhook timestamp (in seconds)
# Default: 300 (5 minutes)
WEBHOOK_TIMESTAMP_TOLERANCE_SEC=300

# ============================================================================
# REVENUE TRACKING
# ============================================================================

# Directory to store revenue tracking data
REVENUE_DATA_DIR=.runtime/revenue

# Revenue tracking database type (optional)
# Options: mongodb, postgres, sqlite, jsonl
REVENUE_TRACKING_DB=jsonl

# Database connection string (if using database)
REVENUE_DB_URL=mongodb://localhost:27017/profitengine

# ============================================================================
# EMAIL NOTIFICATIONS
# ============================================================================

# Email provider for payment notifications
# Options: sendgrid, mailgun, smtp, resend
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=your_email_provider_api_key
EMAIL_FROM_ADDRESS=payments@yourdomain.com

# Payment confirmation email template
PAYMENT_CONFIRMATION_EMAIL_ID=d-your-template-id

# Payment failure email template
PAYMENT_FAILURE_EMAIL_ID=d-your-template-id

# Subscription renewal email template
SUBSCRIPTION_RENEWAL_EMAIL_ID=d-your-template-id

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log level for payment automation
LOG_LEVEL=info

# Enable detailed webhook logging
WEBHOOK_LOG_DETAILS=true

# Error tracking service (optional)
# Options: sentry, datadog, bugsnag
ERROR_TRACKING_SERVICE=sentry
SENTRY_DSN=your_sentry_dsn

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable automatic tax calculation
ENABLE_AUTO_TAX=true

# Enable subscription auto-renewal
ENABLE_AUTO_RENEWAL=true

# Enable refund processing
ENABLE_REFUNDS=true

# Enable revenue tracking
ENABLE_REVENUE_TRACKING=true

# ============================================================================
# TESTING (Development Only)
# ============================================================================

# Use Stripe test mode keys for development
STRIPE_TEST_MODE=false

# Test webhook secret (for local development with ngrok)
# STRIPE_WEBHOOK_SECRET_TEST=whsec_test_xxxxx

# ============================================================================
# NOTES
# ============================================================================

# In production:
# 1. Ensure STRIPE_SECRET_KEY is stored in secure environment variables
# 2. Set up webhook endpoint and copy STRIPE_WEBHOOK_SECRET
# 3. Configure EMAIL_* variables for payment notifications
# 4. Set up revenue tracking database (optional but recommended)
# 5. Enable ERROR_TRACKING_SERVICE for monitoring
# 6. Set WEBHOOK_VERIFY_TIMESTAMP=true for security
#
# Test webhook signature locally:
# 1. Install ngrok: https://ngrok.com
# 2. Run: ngrok http 3000
# 3. Add https://xxxxx.ngrok.io/api/automation/stripe/webhook to Stripe webhooks
# 4. Run: npm test -- stripe-automation.test.ts
#
# To get Stripe test credentials:
# 1. Create a free Stripe account: https://stripe.com
# 2. Go to Dashboard → Developers → API keys
# 3. Copy Test Secret Key to STRIPE_SECRET_KEY
# 4. Copy Test Publishable Key to STRIPE_PUBLISHABLE_KEY
# 5. Go to Webhooks and copy Test Signing Secret
