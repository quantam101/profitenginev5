FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
COPY runtime ./runtime
COPY agents ./agents
COPY connectors ./connectors
COPY scripts/setup-telegram-command-webhook.py ./scripts/setup-telegram-command-webhook.py
COPY scripts/printify_shop_status.py scripts/push_printify_catalog.py scripts/fye_run.py scripts/fye_worker.py scripts/fye_publish.py scripts/fye_dispatch.py ./scripts/
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3).read()"
CMD ["uvicorn", "runtime.api:app", "--host", "0.0.0.0", "--port", "8080"]
