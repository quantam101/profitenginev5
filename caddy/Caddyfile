# Port 80 health probe for CI and monitoring.
# The catch-all redir MUST be inside a handle {} block so Caddy treats it
# as "else" — a bare redir fires before handle matches in Caddy v2.
:80 {
  handle /health {
    respond `{"ok":true,"caddy":"up"}` 200
  }
  handle {
    redir https://{host}{uri} 308
  }
}

{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
  encode gzip zstd
  reverse_proxy web:3000

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  }
}

app.{$SITE_DOMAIN} {
  encode gzip zstd
  reverse_proxy web:3000

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  }
}

api.{$SITE_DOMAIN} {
  encode gzip zstd

  # Route Stripe webhooks to the Node backend
  handle_path /stripe/* {
    reverse_proxy backend:8001
  }

  # Route runtime/agent API calls to the Python FastAPI service
  handle_path /runtime/* {
    reverse_proxy runtime:8080
  }

  # Default: backend (payments, health, agents)
  handle {
    reverse_proxy backend:8001
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}

backend.{$SITE_DOMAIN} {
  encode gzip zstd

  handle_path /taylor/* {
    reverse_proxy taylor:8001
  }

  handle_path /runtime/* {
    reverse_proxy runtime:8080
  }

  handle {
    reverse_proxy backend:8001
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  }
}

taylor.{$SITE_DOMAIN} {
  encode gzip zstd
  reverse_proxy taylor:8001

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  }
}

status.{$SITE_DOMAIN} {
  encode gzip zstd
  reverse_proxy uptime-kuma:3001
}

