[Unit]
Description=ProfitEngine runtime image update
Documentation=https://github.com/quantam101/profitenginev5
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=opc
WorkingDirectory=/home/opc/profitenginev5
Environment=APP_DIR=/home/opc/profitenginev5
Environment=IMAGE=ghcr.io/quantam101/profitenginev5-runtime:latest
Environment=LOCAL_IMAGE=profitenginev5-runtime:latest
Environment=SERVICE=runtime
Environment=HEALTH_URL=https://api.profitengine.alreadyherellc.com/health
Environment=MAX_HEALTH_TRIES=24
Environment=HEALTH_SLEEP_SEC=5
# bash-wrapped so a stripped execute bit (e.g. git reset from a Windows
# commit) can never 203/EXEC the unit again
ExecStart=/bin/bash /home/opc/profitenginev5/scripts/oci-runtime-update.sh
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
