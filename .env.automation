# ═══════════════════════════════════════════════════════════════════════════════
# ProfitEngine v5 — Automation Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.automation.local (never commit)
# 2. Fill in all values from your API provider accounts
# 3. Run: npm run verify:automation to validate all keys
# 4. Add all SECRETS_* values to GitHub Secrets (see AUTOMATION_SETUP.md)
#
# Never commit real API keys to the repo.
# Store in GitHub Secrets only — CI/CD jobs access them from there.
#

# ─────────────────────────────────────────────────────────────────────────────────
# GUMROAD: Product Publishing & Sales Tracking
# ─────────────────────────────────────────────────────────────────────────────────
# Get API key: https://app.gumroad.com/settings/advanced
GUMROAD_API_KEY=<your-gumroad-api-key>
GUMROAD_CREATOR_ID=alreadyhere
# Webhook secret for real-time sales tracking (generated by register script)
GUMROAD_WEBHOOK_SECRET=<auto-generated-by-register-gumroad-webhook.py>

# ─────────────────────────────────────────────────────────────────────────────────
# INSTAGRAM: Direct Audience Engagement & Stories/Reels
# ─────────────────────────────────────────────────────────────────────────────────
# Setup: https://developers.facebook.com → App → Instagram Graph API
# Get Access Token: Meta Business Manager → Settings → System Users
INSTAGRAM_ACCESS_TOKEN=<your-instagram-access-token>
INSTAGRAM_BUSINESS_ACCOUNT_ID=<your-ig-business-account-id>
# Business account ID: Meta Business Manager → Instagram Accounts → Account ID
# Example: 17841400963180 (replace with your actual ID)
INSTAGRAM_HASHTAGS=profittrading,financialfreedom,daytrading,passiveincome

# ─────────────────────────────────────────────────────────────────────────────────
# IMAGE GENERATION: DALL-E or Replicate
# ─────────────────────────────────────────────────────────────────────────────────
# Option A: OpenAI DALL-E 3 (paid, high quality)
DALLE_API_KEY=<your-openai-api-key>
# Option B: Replicate (free tier available, more affordable)
REPLICATE_API_TOKEN=<your-replicate-api-token>
# Choose which to use (default: replicate)
IMAGE_GENERATION_PROVIDER=replicate

# ─────────────────────────────────────────────────────────────────────────────────
# VIDEO GENERATION: Synthesia (for talking-head product demos)
# ─────────────────────────────────────────────────────────────────────────────────
# Get API key: https://synthesia.io → Dashboard → Integrations → API
SYNTHESIA_API_KEY=<your-synthesia-api-key>
# Avatar ID for product demo videos (set in Synthesia dashboard)
SYNTHESIA_AVATAR_ID=

# ─────────────────────────────────────────────────────────────────────────────────
# VOICEOVER: Eleven Labs (for product demo narration)
# ─────────────────────────────────────────────────────────────────────────────────
# Get API key: https://elevenlabs.io → Account → API Key
ELEVEN_LABS_API_KEY=<your-elevenlabs-api-key>
# Voice ID for product demo (default: female professional voice)
# Examples: 21m00Tcm4TlvDq8ikWAM (Rachel), EXAVITQu4vr4xnSDxMaL (Bella)
ELEVEN_LABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ─────────────────────────────────────────────────────────────────────────────────
# EMAIL MARKETING PLATFORM: Choose one (Klaviyo, Substack, or ConvertKit)
# ─────────────────────────────────────────────────────────────────────────────────
EMAIL_PLATFORM=klaviyo
# Set only ONE of the following:

# Option A: Klaviyo (SMS + Email, best for conversions)
# Get API key: https://www.klaviyo.com/account/account#integrations/api-keys
KLAVIYO_API_KEY=<your-klaviyo-api-key>
KLAVIYO_LIST_ID=<your-klaviyo-list-id>

# Option B: Substack (Email newsletter)
# Get API key: https://substack.com/dashboard/settings/account → Newsletter API
SUBSTACK_API_KEY=<your-substack-api-key>
SUBSTACK_PUBLICATION_ID=<your-substack-publication-id>

# Option C: ConvertKit (Email + memberships)
# Get API key: https://convertkit.com/account/integrations → API
CONVERTKIT_API_KEY=<your-convertkit-api-key>
CONVERTKIT_FORM_ID=<your-convertkit-form-id>

# ─────────────────────────────────────────────────────────────────────────────────
# GITHUB ACTIONS: Automation Trigger & Status
# ─────────────────────────────────────────────────────────────────────────────────
# GitHub PAT with repo + workflow scopes (for triggering workflows)
# Generate: https://github.com/settings/tokens → Personal access tokens → Tokens (classic)
GITHUB_ACTIONS_TOKEN=<your-github-pat-token>
GITHUB_ACTIONS_OWNER=quantam101
GITHUB_ACTIONS_REPO=profitengine-v5

# ─────────────────────────────────────────────────────────────────────────────────
# SLACK: Notifications & Status Updates
# ─────────────────────────────────────────────────────────────────────────────────
# Webhook URL for automation status updates (success/failure notifications)
# Create: https://api.slack.com/apps → Your App → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Channel for automation alerts
SLACK_NOTIFICATION_CHANNEL=#automation-alerts
# Optional: direct message to a user ID (format: @username)
SLACK_NOTIFICATION_MENTION=@stephen

# ─────────────────────────────────────────────────────────────────────────────────
# MONITORING & DASHBOARDING
# ─────────────────────────────────────────────────────────────────────────────────
# Local dashboard file path (auto-updated by automation jobs)
AUTOMATION_STATUS_FILE=./automation-status.json
# Dashboard server port (for local testing)
AUTOMATION_DASHBOARD_PORT=8765

# ─────────────────────────────────────────────────────────────────────────────────
# CONTENT CALENDAR & SCHEDULING
# ─────────────────────────────────────────────────────────────────────────────────
# Story posting schedule (comma-separated times, 24-hour format)
STORY_POSTING_TIMES=07:00,14:00,20:00
# Carousel/Reel posting schedule (days of week: Mon,Tue,Wed,Thu,Fri,Sat,Sun)
CAROUSEL_POSTING_DAYS=Tue,Thu,Sat
REEL_POSTING_DAYS=Mon,Wed,Fri

# ─────────────────────────────────────────────────────────────────────────────────
# PRODUCT LAUNCH CONFIG: Which products to automate
# ─────────────────────────────────────────────────────────────────────────────────
# JSON array of product slugs to automate (maps to Gumroad product IDs)
PRODUCTS_TO_AUTOMATE=["trading-course","alert-system","profit-blueprint"]

# ─────────────────────────────────────────────────────────────────────────────────
# AFFILIATE TRACKING
# ─────────────────────────────────────────────────────────────────────────────────
# Amazon Associates tag
AMAZON_ASSOCIATE_TAG=alreadyhere-20
# Affiliate links mapping (JSON)
AFFILIATE_LINKS={"VPS hosting":"https://ref.url","Python book":"https://amzn.to/xxx"}

# ─────────────────────────────────────────────────────────────────────────────────
# RUNTIME ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────────────
# Backend API URL for automation status callbacks
RUNTIME_API_URL=http://129.146.236.177:8000
# Enable detailed logging (verbose output)
AUTOMATION_DEBUG=false
# Dry-run mode (simulate automation without publishing)
AUTOMATION_DRY_RUN=false
# Timeout for API requests (milliseconds)
AUTOMATION_TIMEOUT_MS=30000
