{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["connectors"],
  "additionalProperties": false,
  "properties": {
    "connectors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["state", "enabled", "permissions"],
        "additionalProperties": false,
        "properties": {
          "state": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "policy_file": { "type": "string", "minLength": 1 },
          "autopublish_policy_file": { "type": "string", "minLength": 1 },
          "token_env_var": { "type": "string", "minLength": 1 },
          "fallback": { "type": "string", "minLength": 1 },
          "warmup_started": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "supervised_autopublish_starts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "current_mode": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
