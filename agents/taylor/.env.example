# ── Taylor — Already Here LLC Voice Agent ─────────────────────────────────────
# Fill ALL values before starting. No defaults, no placeholders.

# ── Stripe (primary payment engine) ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...

# ── Twilio (primary telephony) ────────────────────────────────────────────────
# Get at console.twilio.com — buy a Phoenix AZ number
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+16025550100        # Your purchased Twilio number

# ── Telnyx (backup telephony) ─────────────────────────────────────────────────
# Get at telnyx.com — configure same-number fallback routing
TELNYX_API_KEY=KEY...
TELNYX_FROM_NUMBER=+16025550101        # Your Telnyx backup number

# ── Retell AI (primary voice engine) ─────────────────────────────────────────
RETELL_API_KEY=key_...
RETELL_AGENT_ID=agent_...
RETELL_WEBHOOK_URL=https://api.retellai.com

# ── Vapi (backup voice engine) ────────────────────────────────────────────────
VAPI_API_KEY=...
VAPI_WEBHOOK_URL=https://api.vapi.ai

# ── LLM Failover Chain (set whichever you have — Taylor uses first available) ─
# Priority: Ollama (free) → DeepSeek → Gemini → Claude Haiku → GPT-4o-mini → Claude Sonnet → GPT-4o

OLLAMA_API_KEY=ollama                  # Always set this — Ollama ignores it but key must exist
OLLAMA_BASE_URL=http://localhost:11434

DEEPSEEK_API_KEY=                      # platform.deepseek.com — $0.14/1M tokens
GOOGLE_API_KEY=                        # aistudio.google.com — FREE tier (15 RPM, 1M/day)
ANTHROPIC_API_KEY=                     # console.anthropic.com — Claude Haiku + Sonnet
OPENAI_API_KEY=                        # platform.openai.com — GPT-4o-mini + GPT-4o

# ── Taylor server config ──────────────────────────────────────────────────────
TAYLOR_PORT=8001
TAYLOR_TRANSFER_NUMBER=+16028822920           # Primary
TAYLOR_TRANSFER_NUMBER_BACKUP=+16198066457    # Backup 1
TAYLOR_TRANSFER_NUMBER_BACKUP_2=+16198849241  # Backup 2

# ── Shared pipeline config ────────────────────────────────────────────────────
MESH_DB_PATH=production_mesh_edge.db

# ── Performance targets (configure in voice platform dashboard) ───────────────
# System latency target:     240ms – 310ms
# Voice Activity Detection:  180ms
# Barge-in sensitivity:      0.98
# API timeout hard cap:      950ms
# TTS engine:                Cartesia Sonic v3.5
