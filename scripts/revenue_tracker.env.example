# Revenue Tracker Configuration
# Copy this to .env and fill in your actual API keys

# ── Stripe (Newsletter, Direct Sales) ────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx

# ── Gumroad (Ebook, Template, Guide Sales) ──────────────────────────────────
# Get from: https://gumroad.com/account/settings/api
GUMROAD_API_TOKEN=xxxxxxxxxxxxx
# Your Gumroad store username (e.g., 'alreadyhere')
GUMROAD_CREATOR_ID=alreadyhere

# ── Printify (Print-on-Demand Sales) ────────────────────────────────────────
# Get from: https://www.printify.com/account/connected-accounts
PRINTIFY_API_TOKEN=xxxxxxxxxxxxxxxxxxxxx

# ── YouTube Analytics (AdSense Revenue) ─────────────────────────────────────
# Optional: Requires OAuth setup from Google Cloud Console
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# ── Mailchimp (Newsletter Subscriber Data) ──────────────────────────────────
# Optional: For subscriber count and list metrics
# Get from: https://mailchimp.com/account/basics/
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# ── Telegram Alerts ─────────────────────────────────────────────────────────
# Required for revenue alerts to Telegram
# Bot Token: Message @BotFather on Telegram, /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijk
# Chat ID: Message your bot, then check https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# ── Affiliate Link Tracking ─────────────────────────────────────────────────
# Base URL for affiliate link tracking (optional)
AFFILIATE_TRACKING_URL=https://track.alreadyherellc.com

# ── Storage Paths ───────────────────────────────────────────────────────────
# Path to content metrics database (JSON)
CONTENT_DATABASE_PATH=.runtime/content_metrics.json
# Revenue data will be stored in .runtime/revenue/ (auto-created)

# ── Monthly Revenue Targets (USD) ───────────────────────────────────────────
# These are used for progress tracking and dashboard display
REVENUE_TARGET_NEWSLETTER=400
REVENUE_TARGET_GUMROAD=400
REVENUE_TARGET_PRINTIFY=1000
REVENUE_TARGET_YOUTUBE_AFFILIATE=400
REVENUE_TARGET_SPONSORSHIPS=300
REVENUE_TARGET_TOTAL=2500
