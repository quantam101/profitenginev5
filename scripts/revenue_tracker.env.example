# Unified Revenue Dashboard Configuration
# Copy this to .env and fill in your actual API keys
# For production, store sensitive values in GitHub Secrets instead

# ─── MongoDB (REQUIRED) ────────────────────────────────────────────────────────
# Connection string for MongoDB (MongoDB Atlas or self-hosted)
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true
# Database name for revenue data
MONGODB_DB=profitenginev5

# ─── Stripe (Newsletter Sponsorships + Direct Sales) ──────────────────────────
# Get from: https://dashboard.stripe.com/apikeys (Secret Key)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx

# ─── Gumroad (Ebook, Template, Guide Sales) ──────────────────────────────────
# Get from: https://gumroad.com/account/settings/api
GUMROAD_API_TOKEN=xxxxxxxxxxxxx

# ─── Printify (Print-on-Demand Sales — T-shirts, Hoodies, Prints) ────────────
# Get from: https://www.printify.com/account/connected-accounts
PRINTIFY_API_TOKEN=xxxxxxxxxxxxxxxxxxxxx

# ─── YouTube Analytics (AdSense Revenue — Manual) ────────────────────────────
# Optional: Requires OAuth setup from Google Cloud Console
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# ─── Mailchimp (Newsletter Subscriber Data) ────────────────────────────────────
# Optional: For subscriber count and list metrics
# Get from: https://mailchimp.com/account/basics/
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# ─── Telegram Alerts (Daily Revenue Updates) ───────────────────────────────────
# Bot Token: Message @BotFather on Telegram, /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijk
# Chat ID: Message your bot, then check https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# ─── Affiliate Link Tracking (Optional) ────────────────────────────────────────
# Base URL for affiliate link tracking
AFFILIATE_TRACKING_URL=https://track.alreadyherellc.com

# ─── Content Database (ROI Tracking) ────────────────────────────────────────────
# Path to content metrics database (JSON) — optional
CONTENT_DATABASE_PATH=.runtime/content_metrics.json

# ─── Notes ─────────────────────────────────────────────────────────────────────
# MONGODB_URI is REQUIRED for production.
# Without it, data is stored locally in .runtime/revenue/transactions.jsonl
#
# API keys are optional — only add if you want automatic fetching from that service.
# For manual tracking (YouTube AdSense, Affiliate commissions), you can skip these keys.
#
# For GitHub Actions CI/CD, add sensitive values to GitHub Secrets:
#   - MONGODB_URI
#   - STRIPE_SECRET_KEY
#   - GUMROAD_API_TOKEN
#   - PRINTIFY_API_TOKEN
#   - TELEGRAM_BOT_TOKEN
#   - TELEGRAM_CHAT_ID
#
# Revenue targets (hardcoded in scripts, adjust as needed):
#   - Newsletter: $400/mo
#   - Gumroad: $400/mo
#   - Printify: $1,000/mo (PRIMARY)
#   - YouTube: $400/mo
#   - Affiliate: $400/mo
#   - Sponsorships: $300/mo
#   - TOTAL: $2,500/mo
