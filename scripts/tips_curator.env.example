# Tips Curator Configuration
# Copy to .env and fill in your actual values

# ── LLM Configuration ──────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
GMAOS_GROQ_MODEL=llama-3.3-70b-versatile

# ── GitHub Content Repository ─────────────────────────────────────────────────
GITHUB_CONTENT_TOKEN=ghp_YOUR_GITHUB_PAT_WITH_REPO_SCOPE
GITHUB_CONTENT_OWNER=quantam101
GITHUB_CONTENT_REPO=content
GITHUB_CONTENT_BRANCH=main
GITHUB_CONTENT_DIR=posts

# ── Twitter/X API (Optional) ──────────────────────────────────────────────────
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=YOUR_TWITTER_API_KEY
TWITTER_API_SECRET=YOUR_TWITTER_API_SECRET
TWITTER_ACCESS_TOKEN=YOUR_TWITTER_ACCESS_TOKEN
TWITTER_ACCESS_SECRET=YOUR_TWITTER_ACCESS_SECRET

# ── LinkedIn API (Optional) ────────────────────────────────────────────────────
# Get from: https://www.linkedin.com/developers
LINKEDIN_ACCESS_TOKEN=YOUR_LINKEDIN_ACCESS_TOKEN
LINKEDIN_PERSON_URN=urn:li:person:YOUR_PERSON_ID

# ── Instagram/Facebook Business API (Optional) ─────────────────────────────────
# Get from: https://developers.facebook.com
INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN
IG_USER_ID=YOUR_IG_USER_ID

# ── Gumroad API (Optional) ────────────────────────────────────────────────────
# Get from: https://gumroad.com/settings/account
GUMROAD_ACCESS_TOKEN=YOUR_GUMROAD_ACCESS_TOKEN

# ── Monetization Configuration ─────────────────────────────────────────────────

# Affiliate links (JSON format)
# Used for tool promotions in tips
AFFILIATE_LINKS='{
  "zapier": "https://zapier.com?aid=YOUR_AFFILIATE_ID",
  "notion": "https://notion.so?ref=YOUR_REFERRAL_CODE",
  "figma": "https://figma.com/?ref=YOUR_REFERRAL",
  "descript": "https://www.descript.com?utm_source=alreadyhere",
  "grammarly": "https://grammarly.com?affiliate=alreadyhere",
  "mixpanel": "https://mixpanel.com?partner=alreadyhere",
  "openai": "https://openai.com"
}'

# Amazon Associates tag
AMAZON_PARTNER_TAG=alreadyhere-20

# Enable/disable monetization injection
MONETIZATION_ENABLED=true

# ── Output Configuration ───────────────────────────────────────────────────────
TIPS_OUTPUT_DIR=data/tips
TIPS_EBOOK_CHAPTERS=5

# ── Verification Mode (Set to "true" to verify credentials without API calls) ──
TIPS_VERIFY_ONLY=false
