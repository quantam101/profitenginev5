# News Updater Configuration
# Copy to .env and fill in your values

# ============================================================================
# NEWS API KEYS
# ============================================================================

# NewsAPI.org - Sign up free at https://newsapi.org
# Free tier: 100 requests per day, $9.99/month for more
NEWSAPI_KEY=your_newsapi_key_here

# ============================================================================
# EMAIL/NEWSLETTER CONFIGURATION
# ============================================================================

# Newsletter service API key
NEWSLETTER_API_KEY=your_newsletter_key_here

# Email configuration (if using direct email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Newsletter recipient list (comma-separated or use service)
NEWSLETTER_FROM=noreply@profitengine.ai
NEWSLETTER_SUBJECT_PREFIX=Daily Digest

# ============================================================================
# BACKEND/API CONFIGURATION
# ============================================================================

# ProfitEngine backend URL
PROFITENGINE_URL=https://profitengine-tau.vercel.app

# Backend API key (if required)
API_KEY=your_api_key_here

# Backend article endpoint
API_ARTICLE_ENDPOINT=/api/articles

# ============================================================================
# SOCIAL MEDIA CONFIGURATION
# ============================================================================

# Twitter/X
TWITTER_CONSUMER_KEY=your_consumer_key_here
TWITTER_CONSUMER_SECRET=your_consumer_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Twitter API v2 (preferred)
TWITTER_BEARER_TOKEN=your_bearer_token_here

# LinkedIn
LINKEDIN_ACCESS_TOKEN=your_linkedin_token_here

# Facebook
FACEBOOK_PAGE_TOKEN=your_facebook_token_here

# ============================================================================
# CONTENT & AFFILIATE CONFIGURATION
# ============================================================================

# Amazon Associates
AMAZON_ASSOCIATES_TAG=alreadyhere-20

# Custom affiliate URLs
AFFILIATE_CHATGPT=https://chat.openai.com/?utm_source=profitengine
AFFILIATE_VERCEL=https://vercel.com?utm_source=profitengine
AFFILIATE_GUMROAD=https://gumroad.com?utm_source=profitengine
AFFILIATE_PRINTFUL=https://printful.com/?utm_source=profitengine
AFFILIATE_SUBSTACK=https://substack.com?utm_source=profitengine

# Content repository
GITHUB_CONTENT_OWNER=quantam101
GITHUB_CONTENT_REPO=content
GITHUB_TOKEN=your_github_token_here

# ============================================================================
# CONTENT GENERATION
# ============================================================================

# OpenAI (for optional AI commentary generation)
OPENAI_API_KEY=your_openai_key_here

# Content tone/voice
CONTENT_TONE=professional-casual
CONTENT_VOICE=entrepreneur-friendly

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Sentry error tracking (optional)
SENTRY_DSN=https://key@sentry.io/project_id

# Slack notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================================
# SCHEDULED EXECUTION
# ============================================================================

# Cron schedule for automated runs
# Default: 0 9 * * * (9 AM UTC daily)
CRON_SCHEDULE=0 9 * * *

# Timezone for schedules
TIMEZONE=UTC

# Maximum items per section
MAX_DAILY_DIGEST_ITEMS=5
MAX_INDUSTRY_ITEMS=10
MAX_TRENDING_ITEMS=5

# ============================================================================
# RSS FEEDS (customize as needed)
# ============================================================================

# Add custom RSS feeds (comma-separated URLs)
CUSTOM_RSS_FEEDS=https://example.com/feed.rss,https://another.com/feed.rss

# RSS timeout in seconds
RSS_TIMEOUT=10

# ============================================================================
# NEWS PREFERENCES
# ============================================================================

# News categories to focus on (comma-separated)
FOCUS_CATEGORIES=AI Tools,Passive Income,Business,Technology

# News language
NEWS_LANGUAGE=en

# Minimum engagement score threshold (0.0 to 10.0)
MIN_ENGAGEMENT_SCORE=1.0

# Exclude sources (comma-separated)
EXCLUDED_SOURCES=

# Include only sources (comma-separated, empty = all)
INCLUDED_SOURCES=

# ============================================================================
# OUTPUT CONFIGURATION
# ============================================================================

# Output directory for generated files
OUTPUT_DIR=scripts/output

# Save output to file (true/false)
SAVE_OUTPUT=true

# Retention days for output files
OUTPUT_RETENTION_DAYS=7

# ============================================================================
# OPTIONAL: ADVANCED FEATURES
# ============================================================================

# Enable AI-powered commentary generation
USE_AI_COMMENTARY=false

# Enable sentiment analysis
USE_SENTIMENT_ANALYSIS=false

# Enable trend prediction
USE_TREND_PREDICTION=false

# Enable duplicate detection (more thorough)
ADVANCED_DEDUPLICATION=true

# Cache results for X hours
CACHE_DURATION_HOURS=6

# ============================================================================
# SECURITY
# ============================================================================

# API rate limiting
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_PERIOD=3600  # seconds

# Request timeout
REQUEST_TIMEOUT=10  # seconds

# SSL verification
VERIFY_SSL=true

# ============================================================================
# NOTES
# ============================================================================

# Get API Keys:
#
# NewsAPI.org:
#   1. Go to https://newsapi.org
#   2. Sign up (free)
#   3. Copy API key from dashboard
#
# Twitter/X API:
#   1. Go to https://developer.twitter.com/
#   2. Create app
#   3. Generate tokens in Settings > Keys and tokens
#
# GitHub:
#   1. Go to https://github.com/settings/tokens
#   2. Create Personal Access Token
#   3. Select 'repo' scope
#
# OpenAI:
#   1. Go to https://platform.openai.com/account/api-keys
#   2. Create API key
#
# For GitHub Actions:
#   1. Go to repo Settings > Secrets and variables > Actions
#   2. Add each secret (NEWSAPI_KEY, TWITTER_BEARER_TOKEN, etc.)
#   3. Reference in workflow: ${{ secrets.SECRET_NAME }}
