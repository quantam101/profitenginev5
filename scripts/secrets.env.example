# ─────────────────────────────────────────────────────────────────────────────
# ProfitEngine v5 — Server secrets template
#
# USAGE:
#   1. Copy this file to ~/.profitengine-secrets on the SERVER (not in repo)
#   2. Fill in all values
#   3. chmod 600 ~/.profitengine-secrets
#   4. source ~/.profitengine-secrets && bash scripts/bootstrap-server.sh
#
# This file is a TEMPLATE — never commit the filled-in version.
# ─────────────────────────────────────────────────────────────────────────────

# Inference cascade — free AI tiers
GROQ_API_KEY=                        # https://console.groq.com
GEMINI_API_KEY=                      # https://aistudio.google.com/apikey

# GitHub content publishing
GITHUB_CONTENT_TOKEN=                # https://github.com/settings/tokens (repo scope)
GITHUB_CONTENT_OWNER=quantam101
GITHUB_CONTENT_REPO=content
GITHUB_CONTENT_BRANCH=main
GITHUB_CONTENT_DIR=_posts

# Gmail digest alerts
GMAIL_USER=alreadyherellc@gmail.com
GMAIL_APP_PASSWORD=                  # https://myaccount.google.com/apppasswords
ALERT_EMAIL=stephen47@gmail.com

# n8n automation
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=             # choose a strong password

# Taylor voice agent and payment links
# Base URL for the voice-agent server (use the ProfitEngine Render runtime if self-hosted)
TAYLOR_SERVER_URL=https://profitengine-runtime.onrender.com/taylor
TAYLOR_DB_PATH=/data/taylor.db
TAYLOR_TRANSFER_NUMBER=
TAYLOR_TRANSFER_NUMBER_BACKUP=
TAYLOR_TRANSFER_NUMBER_BACKUP_2=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_PHONE_NUMBER_SID=
TWILIO_AREA_CODE=602
STRIPE_SECRET_KEY=
# Payment redirect URLs (point to real pages on your domain)
TAYLOR_PAYMENT_SUCCESS_URL=https://www.alreadyherellc.com/payment/success
TAYLOR_PAYMENT_CANCEL_URL=https://www.alreadyherellc.com/payment/cancel
OLLAMA_API_KEY=ollama
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Telegram command gateway
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=https://profitengine-runtime.onrender.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# Optional: Dev.to publishing
# DEVTO_API_KEY=                     # https://dev.to/settings/extensions

# Optional: Affiliate link map (JSON)
# AFFILIATE_LINKS={"VPS hosting": "https://ref.url"}
