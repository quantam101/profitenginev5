# ProfitEngine v5 Email List Manager Configuration

# Database
EMAIL_DB_PATH=profitengine_subscribers.db

# Email Service Integrations

# Beehiiv
BEEHIIV_API_KEY=your-beehiiv-api-key-here
BEEHIIV_PUBLICATION_ID=your-publication-id-here

# Resend
RESEND_API_KEY=your-resend-api-key-here
RESEND_AUDIENCE_ID=your-audience-id-here

# Mailchimp
MAILCHIMP_API_KEY=your-mailchimp-api-key-here
MAILCHIMP_LIST_ID=your-list-id-here
MAILCHIMP_SERVER_PREFIX=us1

# Email Configuration
SENDER_EMAIL=noreply@alreadyherellc.com
SENDER_NAME=Already Here LLC
REPLY_TO_EMAIL=support@alreadyherellc.com

# Frontend URLs (for confirmation/unsubscribe links)
CONFIRMATION_BASE_URL=https://alreadyherellc.com/email/confirm
UNSUBSCRIBE_BASE_URL=https://alreadyherellc.com/email/unsubscribe
PREFERENCE_BASE_URL=https://alreadyherellc.com/email/preferences

# Lead Magnet CDN
LEAD_MAGNET_CDN=https://cdn.alreadyherellc.com

# Tracking (optional)
TRACK_OPENS=true
TRACK_CLICKS=true
MAX_IP_LOG_RETENTION_DAYS=30

# Analytics
ENABLE_DAILY_DIGEST=true
DAILY_DIGEST_TIME=08:00  # UTC

# Segment Configuration
AUTO_SEGMENT_INACTIVE_DAYS=90
HIGH_ENGAGEMENT_MIN_OPENS=10
HIGH_ENGAGEMENT_MIN_CLICKS=5

# Referral Settings
REFERRAL_REWARDS_ENABLED=true
REFERRAL_REWARD_AMOUNT=5.00
REFERRAL_CURRENCY=USD

# Growth Automation
AUTO_WELCOME_SERIES=true
WELCOME_SERIES_DELAY_MINUTES=5

# Rate Limiting
MAX_SUBSCRIBE_PER_IP_PER_HOUR=10
MAX_MAGNET_DOWNLOADS_PER_EMAIL_PER_DAY=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/email_manager.log

# Security
ENABLE_RATE_LIMITING=true
REQUIRE_HTTPS=true
CORS_ALLOWED_ORIGINS=https://alreadyherellc.com,https://app.alreadyherellc.com
