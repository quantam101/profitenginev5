# Already Here LLC — N8N + Taylor Stack
# Copy to .env and fill all values before running docker compose

# N8N instance
N8N_HOST=n8n.alreadyherellc.com          # or use the OCI IP: 129.146.167.73
N8N_ADMIN_USER=admin
N8N_ADMIN_PASSWORD=strong-password-here
N8N_DB_PASSWORD=strong-db-password-here
N8N_ENCRYPTION_KEY=32-char-random-string-here

# Stripe
STRIPE_SECRET_KEY=sk_live_...

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+16025550100

# Retell AI (primary voice)
RETELL_API_KEY=key_...

# Vapi (backup voice)
VAPI_API_KEY=...
