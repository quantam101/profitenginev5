#!/bin/bash
# Pre-commit hook to prevent accidental secret commits
# Install: ln -sf ../../.github/hooks/pre-commit .git/hooks/pre-commit

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Patterns that indicate secrets
SECRET_PATTERNS=(
    # API Keys
    "sk_live_"
    "sk_test_"
    "sk-proj-"
    "gsk_"
    "AIzaSy"
    "AKIA[0-9A-Z]{16}"  # AWS
    "ghp_[A-Za-z0-9_]*"  # GitHub Personal
    "ghs_[A-Za-z0-9_]*"  # GitHub OAuth
    "ghu_[A-Za-z0-9_]*"  # GitHub User

    # Database credentials
    "mongodb+srv://[^@]*:[^@]*@"
    "postgres://.*:.*@"
    "mysql://.*:.*@"

    # Tokens
    "TELEGRAM_BOT_TOKEN="
    "TWILIO_AUTH_TOKEN="
    "STRIPE_SECRET_KEY=sk_"
    "OPENAI_API_KEY=sk"

    # Passwords
    "PASSWORD=['\"]?[A-Za-z0-9!@#$%^&*]{12,}['\"]?"
)

# Files that should never contain secrets
SENSITIVE_FILES=(
    ".env"
    ".env.local"
    ".env.production"
    "secrets.env"
    "credentials.json"
    ".profitengine-secrets"
)

# Get staged files
STAGED_FILES=$(git diff --cached --name-only)

# Check if any .env files are being committed
for file in $STAGED_FILES; do
    for sensitive in "${SENSITIVE_FILES[@]}"; do
        if [[ "$file" == *"$sensitive"* ]]; then
            echo -e "${RED}❌ ERROR: Cannot commit $file${NC}"
            echo "This file may contain secrets. Move it to .gitignore or rename to .example"
            exit 1
        fi
    done
done

# Scan staged content for secret patterns
for pattern in "${SECRET_PATTERNS[@]}"; do
    if git diff --cached -i -U0 | grep -E "$pattern" >/dev/null; then
        echo -e "${RED}❌ ERROR: Potential secret detected!${NC}"
        echo "Pattern found: $pattern"
        echo ""
        echo "Staged changes containing potential secrets:"
        git diff --cached -i -U0 | grep -E "$pattern" | head -10
        echo ""
        echo "If this is a false positive:"
        echo "  1. Verify it's not a real credential"
        echo "  2. Unstage the file and try again"
        echo "  3. Use: git reset HEAD <file>"
        exit 1
    fi
done

# Check git history for leaked secrets (shallow scan of recent commits)
RECENT_COMMITS=$(git log --oneline -n 10 2>/dev/null | awk '{print $1}')
for commit in $RECENT_COMMITS; do
    for pattern in "${SECRET_PATTERNS[@]}"; do
        if git show $commit:* 2>/dev/null | grep -E "$pattern" >/dev/null; then
            echo -e "${YELLOW}⚠️  WARNING: Found pattern in recent history${NC}"
            echo "Pattern: $pattern in commit $commit"
            echo ""
            echo "This may be a false positive. Monitor for unauthorized access."
        fi
    done
done

echo -e "${GREEN}✓ Pre-commit security check passed${NC}"
exit 0
